# 复制为 .env.production 后填写，勿提交仓库
# cp .env.production.example .env.production

# ---------- 对外访问（构建 Web 镜像时注入，无末尾斜杠）----------
# Nginx 监听 8081、仅 HTTP 时示例：
NEXT_PUBLIC_API_URL=http://你的公网IP:8081

# ---------- 数据库 / Redis（Conda 宿主机部署用 localhost）----------
DATABASE_URL=postgresql+asyncpg://postgresql:你的密码@localhost:55443/ai_db
DATABASE_URL_SYNC=postgresql://postgresql:你的密码@localhost:55443/ai_db
REDIS_URL=redis://localhost:7740/0
# 若有密码: redis://:密码@localhost:7740/0

# ---------- 应用 ----------
CORS_ORIGINS=http://你的公网IP:8081

MOCK_LLM=false
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

FOOTBALL_DATA_API_KEY=
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com

MAX_ROUNDS=30
DELIBERATION_TIMEOUT_SECONDS=2700
PROMPT_VERSION=v1
GRAPH_VERSION=v1

HOT_MATCH_PREGEN_HOURS=24
HOT_MATCH_IDS=wc2026-final,wc2026-semi-1
