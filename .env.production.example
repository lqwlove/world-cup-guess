# 复制为 .env.production 后填写，勿提交仓库
# cp .env.production.example .env.production

# ---------- 对外访问（构建 Web 镜像时注入，无末尾斜杠）----------
# Nginx 监听 8081、仅 HTTP 时示例：
NEXT_PUBLIC_API_URL=http://你的公网IP:8081

# ---------- 数据库 / Redis（Conda 宿主机部署用 localhost）----------
DATABASE_URL=postgresql+asyncpg://postgresql:你的密码@localhost:55443/ai_db
DATABASE_URL_SYNC=postgresql://postgresql:你的密码@localhost:55443/ai_db
# Redis（端口 7740；宝塔/自建 Redis 通常 requirepass）
# 仅密码（最常见）:
REDIS_URL=redis://:你的Redis密码@localhost:7740/0
# 有用户名时（Redis 6 ACL，如 default）:
# REDIS_URL=redis://default:你的Redis密码@localhost:7740/0
# 密码含 @:# 等特殊字符需 URL 编码，或见 docs/DEPLOY.md

# ---------- 应用 ----------
CORS_ORIGINS=http://你的公网IP:8081

MOCK_LLM=false
# LLM：openai | deepseek | volcengine | anthropic（后三者中前两个走 OpenAI 兼容接口）
LLM_PROVIDER=volcengine
LLM_MODEL=doubao-seed-2-0-pro-260215
OPENAI_API_KEY=ark-833958a9-de92-47a4-b5f4-2bf5bb412c55-5af81
# 可选，不填则用各厂商默认地址：
#   deepseek  -> https://api.deepseek.com
#   volcengine -> https://ark.cn-beijing.volces.com/api/v3
#   openai    -> https://api.openai.com/v1
OPENAI_API_BASE=https://ark.cn-beijing.volces.com/api/v3
ANTHROPIC_API_KEY=

# --- DeepSeek 示例 ---
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# OPENAI_API_KEY=sk-xxx

# --- 火山引擎方舟（OpenAI 兼容）示例 ---
# LLM_PROVIDER=volcengine
# LLM_MODEL=ep-xxxxxxxxxx-xxxxx
# OPENAI_API_KEY=方舟 API Key
# OPENAI_API_BASE=https://ark.cn-beijing.volces.com/api/v3

FOOTBALL_DATA_API_KEY=
# 世界杯赛事实时数据（数据概览 Tab）
FOOTBALL_DATA_COMPETITION=WC
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com

# 网络搜索（Agent 获取主客队最新伤病/阵容动态）
# 配置 TAVILY_API_KEY 时优先用 Tavily；未配置则回退 DuckDuckGo（无需 key）
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5

MAX_ROUNDS=30
DELIBERATION_TIMEOUT_SECONDS=2700
PROMPT_VERSION=v1
GRAPH_VERSION=v2
GRAPH_CHECKPOINT_ENABLED=true

HOT_MATCH_PREGEN_HOURS=24
HOT_MATCH_IDS=fifa-400021543,fifa-400021541,fifa-400021496
