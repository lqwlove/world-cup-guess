# 复制为 .env.production 后填写，勿提交仓库
# cp .env.production.example .env.production

# ---------- 对外访问（构建 Web 镜像时注入）----------
NEXT_PUBLIC_API_URL=https://wc.example.com

# ---------- 宿主机 PostgreSQL ----------
# 你在服务器上的连接（宿主机本机）示例：
#   postgresql+psycopg://postgresql:密码@localhost:55443/ai_db
#
# Docker 容器内必须把 localhost 换成 host.docker.internal，且 API 使用 asyncpg 驱动：
DATABASE_URL=postgresql+asyncpg://postgresql:你的密码@host.docker.internal:55443/ai_db
# Alembic 迁移用同步连接（不要用 +psycopg / +asyncpg 前缀）：
DATABASE_URL_SYNC=postgresql://postgresql:你的密码@host.docker.internal:55443/ai_db

# ---------- Redis（Compose 内 redis 服务）----------
REDIS_URL=redis://redis:6379/0

# ---------- 应用 ----------
CORS_ORIGINS=https://wc.example.com

MOCK_LLM=false
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

FOOTBALL_DATA_API_KEY=
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com

MAX_ROUNDS=30
DELIBERATION_TIMEOUT_SECONDS=2700
PROMPT_VERSION=v1
GRAPH_VERSION=v1

HOT_MATCH_PREGEN_HOURS=24
HOT_MATCH_IDS=wc2026-final,wc2026-semi-1
